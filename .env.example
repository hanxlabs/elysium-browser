# Required. Generate a long random value and keep it out of source control.
BROWSER_GATEWAY_TOKEN=replace-with-a-long-random-token

# Browser execution settings.
BROWSER_GATEWAY_HEADLESS=true
BROWSER_GATEWAY_HUMANIZE=true
BROWSER_GATEWAY_HUMAN_PRESET=default
BROWSER_GATEWAY_MAX_CONCURRENCY=2
BROWSER_GATEWAY_DEFAULT_TIMEOUT_SECONDS=45
BROWSER_GATEWAY_MAX_TIMEOUT_SECONDS=60
BROWSER_GATEWAY_MAX_HTML_BYTES=2097152

# Optional CloakBrowser license key. Do not commit a real value.
# CLOAKBROWSER_LICENSE_KEY=
